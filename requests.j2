{%- set host = 'localhost' -%}
{%- set port = 8000 -%}
{%- set baseUrl = 'http://' ~ host ~ ':' ~ port -%}

### Welcome endpoint
GET {{ baseUrl }}/ HTTP/1.1

### Create a new incident
POST {{ baseUrl }}/items HTTP/1.1
Content-Type: application/json

{
  "short_description": "{% if incident_short_desc %}{{ incident_short_desc }}{% else %}Database connection failed{% endif %}",
  "description": "{% if incident_desc %}{{ incident_desc }}{% else %}The production database is not responding to connection requests{% endif %}",
  "criticality": "{% if criticality %}{{ criticality }}{% else %}high{% endif %}",
  "reporter": "{% if reporter %}{{ reporter }}{% else %}john.doe@example.com{% endif %}",
  "assigned_to": "{% if assigned_to %}{{ assigned_to }}{% else %}jane.smith@example.com{% endif %}",
  "service_name": "{% if service %}{{ service }}{% else %}payment-service{% endif %}",
  "environment": "{% if env %}{{ env }}{% else %}production{% endif %}"
}

### List all incidents
GET {{ baseUrl }}/items HTTP/1.1

### List incidents with pagination
GET {{ baseUrl }}/items?limit={{ limit | default(5) }}&offset={{ offset | default(0) }} HTTP/1.1

### Get incident by ID
GET {{ baseUrl }}/items/{{ item_id | default(0) }} HTTP/1.1

### Get non-existent incident (should return 404)
GET {{ baseUrl }}/items/999 HTTP/1.1
